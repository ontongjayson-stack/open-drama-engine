# Deploy only the FastAPI studio and its template/static assets, not the desktop
# application, snapshots, test fixtures, or the separate GPU model repository.
.env
.env.*
/setup_env.py
/OPEN-DRAMA-ENGINE_RestorePoint_Milestone2_Passed.zip
/SkyReels-V2-main/
/generated_assets/
/temp/
/exports/
/docs/
/src/
/tests/
test_*.py
/scifi_city_preview.jpg
# These are root-only legacy/desktop files. A bare index.html would also
# exclude templates/index.html, which the FastAPI dashboard serves at /.
/index.html
/index.css
/engine.js
/server.js
/main.js
/render-worker.js
/package.json
/package-lock.json
*.bat
*.vbs
