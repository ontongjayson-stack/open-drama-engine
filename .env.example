# Run `python setup_env.py` to create your private, real .env. Edit it locally;
# never commit API keys or copy this file into a Vercel deployment.
# For local story generation, fill at least one of these keys:
OPENROUTER_API_KEY=
GEMINI_API_KEY=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_DIR=D:\AI DEVELOPMENTS\ComfyUI
COMFY_RENDER_TIMEOUT=1200
# Optional provider model overrides:
# OPENROUTER_MODEL=
# GEMINI_MODEL=gemini-flash-latest
# ODE_PYTHON_PATH=C:\path\to\python.exe

# Typesafe skill-guided reviews use your existing writer model. No Typesafe key required.
# Optional image observer override:
# CONTINUITY_VISION_MODEL=gemini-flash-latest
# OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
# Enable only after authorizing generated image transfers to OpenRouter:
# ALLOW_OPENROUTER_VISION=1
